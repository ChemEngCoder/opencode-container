#!/usr/bin/env bash
#
# OpenCode Docker wrapper script
# Add this directory to your PATH to run the Docker isolated OpenCode from anywhere

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

bootstrap() {
    local ocd_dir="$HOME/.opencode-docker"
    local repo_dir="${OPENCODE_DOCKER_REPO:-$SCRIPT_DIR}"

    mkdir -p "$ocd_dir"
    chmod 700 "$ocd_dir"

    mkdir -p "$ocd_dir/secrets"
    chmod 700 "$ocd_dir/secrets"

    # Always sync config files from repo (overwrite existing)
    if [ -d "$repo_dir/config" ]; then
        cp -f "$repo_dir/config"/*.json "$ocd_dir/config/" 2>/dev/null || true
    fi

    # Create placeholder API key if no secrets exist
    if [ ! "$(ls -A "$ocd_dir/secrets" 2>/dev/null)" ]; then
        echo "sk-placeholder-replace-me" > "$ocd_dir/secrets/anthropic_api_key"
        chmod 600 "$ocd_dir/secrets/anthropic_api_key"
    fi

    if [ ! -f "$HOME/.gitconfig" ] && [ -f "$repo_dir/.gitconfig" ]; then
        cp "$repo_dir/.gitconfig" "$HOME/.gitconfig"
    fi
}

bootstrap

# Default workspace to current directory if not specified
WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"

if [ -t 0 ]; then
    DOCKER_FLAGS="-it"
else
    DOCKER_FLAGS="-i"
fi

docker run --rm $DOCKER_FLAGS \
    --read-only \
    --tmpfs /tmp:exec,size=512m \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory=2g \
    --cpus=2 \
    -v "$HOME/.opencode-docker:/app:rw" \
    -v "$HOME/.gitconfig:/app/.gitconfig:ro" \
    -v "$HOME/.opencode-docker/config:/app/.config/opencode:ro" \
    -v "$WORKSPACE:/workspace:rw" \
    -v "$HOME/.opencode-docker/secrets:/run/secrets:ro" \
    opencode-docker:latest /workspace "$@"