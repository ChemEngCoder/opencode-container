#!/usr/bin/env bash
#
# OpenCode Apptainer wrapper script
# Add this directory to your PATH to run the container-isolated OpenCode from anywhere
#
# Uses apptainer, or singularity as a fallback, or the binary named by $APPTAINER_BIN.
#
# Options:
#   -w, --websearch     Enable web search (sets OPENCODE_ENABLE_EXA=1)
#   -e, --experimental  Enable experimental features (sets OPENCODE_EXPERIMENTAL=1 and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)
#   -u, --update-config Overwrite ~/.opencode-apptainer/config/ files with repo versions
#   --memory            Set memory limit (default: 4g, e.g., --memory 8g)
#   --cpus              Set CPU count (default: 4, e.g., --cpus 8)
#   --sif PATH          Use a specific .sif image
#   --host-access       Deprecated no-op; Apptainer shares the host network namespace
#
# Any other flags/commands (e.g. -m/--model, -c/--continue, -s/--session,
# auth logout, run "msg") are passed through to the OpenCode CLI.
#
# Environment:
#   OPENCODE_APPTAINER_SIF      path to the .sif image
#   OPENCODE_STATE_DIR          host state dir (default ~/.opencode-apptainer)
#   OPENCODE_WORKSPACE          directory mounted at /workspace (default: cwd)
#   OPENCODE_CONTAINER_REPO     repo root, for seeding config/
#   OPENCODE_LLM_SOCKET_DIR     host dir holding llm.sock (default $XDG_RUNTIME_DIR/opencode)
#   OPENCODE_LLM_PORT           port the in-container relay listens on (default 11434)

set -euo pipefail

UPDATE_CONFIG=0
NO_NET=0
USE_GPU=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_dir="${OPENCODE_CONTAINER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

# --- container runtime ------------------------------------------------------
APPTAINER_BIN==apptainer

# --- host state -------------------------------------------------------------
state_dir="${OPENCODE_STATE_DIR:-$HOME/.opencode-apptainer}"

mkdir -p \
    "$state_dir/config" \
    "$state_dir/secrets" \
    "$state_dir/.config" \
    "$state_dir/.local/share" \
    "$state_dir/.cache"
chmod 700 "$state_dir" "$state_dir/config" "$state_dir/secrets"

# /app/.config/opencode is bound on top of the /app home bind, so the nested
# mount point has to exist on the host side too.
mkdir -p "$state_dir/.config/opencode"

if [ -d "$HOME/.opencode-container" ] && [ ! -e "$state_dir/.migrated-hint" ]; then
    echo "note: ~/.opencode-container exists (Container state). To share it," >&2
    echo "      run with OPENCODE_STATE_DIR=\$HOME/.opencode-container" >&2
    : > "$state_dir/.migrated-hint"
fi

WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"
if [ ! -d "$WORKSPACE" ]; then
    echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2
    exit 1
fi

# --- argument parsing -------------------------------------------------------
EXTRA_ENV=()
MEMORY_LIMIT="${MEMORY_LIMIT:-4g}"
CPU_LIMIT="${CPU_LIMIT:-4}"
SIF="${OPENCODE_APPTAINER_SIF:-}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--update-config) UPDATE_CONFIG=1; shift ;;
        -n|--no-net)        NO_NET=1; shift ;;
        -g|--gpu)           USE_GPU=1; shift ;;
        -w|--websearch)
            EXTRA_ENV+=("OPENCODE_ENABLE_EXA=1")
            shift
            ;;
        -e|--experimental)
            EXTRA_ENV+=("OPENCODE_EXPERIMENTAL=1" "OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1")
            shift
            ;;
        --memory)
            [ "$#" -ge 2 ] || { echo "error: --memory requires a value" >&2; exit 2; }
            MEMORY_LIMIT="$2"
            shift 2
            ;;
        --cpus)
            [ "$#" -ge 2 ] || { echo "error: --cpus requires a value" >&2; exit 2; }
            CPU_LIMIT="$2"
            shift 2
            ;;
        --sif)
            [ "$#" -ge 2 ] || { echo "error: --sif requires a value" >&2; exit 2; }
            SIF="$2"
            shift 2
            ;;
        --host-access)
            echo "note: --host-access is a no-op under Apptainer; the container shares" >&2
            echo "      the host network namespace, so host services are on 127.0.0.1" >&2
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ "$NO_NET" = 1 ] && [[ " ${EXTRA_ENV[*]-} " == *OPENCODE_ENABLE_EXA* ]]; then
    echo "warning: --websearch cannot work with --no-net (no internet reachable)" >&2
fi

# --- image ------------------------------------------------------------------
if [ -z "$SIF" ]; then
    for candidate in \
        "$state_dir/opencode-container.sif" \
        "$repo_dir/images/opencode-container.sif"
    do
        if [ -f "$candidate" ]; then
            SIF="$candidate"
            break
        fi
    done
fi

if [ -z "$SIF" ] || [ ! -f "$SIF" ]; then
    echo "Error: no image found. Build one with 'make build', or pass --sif PATH" >&2
    echo "       (looked in $state_dir/ and $repo_dir/images/)" >&2
    exit 1
fi

# --- config seeding ---------------------------------------------------------
if [ -d "$repo_dir/config" ]; then
    if [ "$UPDATE_CONFIG" = 1 ]; then
        cp -a "$repo_dir/config/." "$state_dir/config/"
    else
        cp -a --update=none "$repo_dir/config/." "$state_dir/config/"
    fi
fi

# --- network isolation ------------------------------------------------------
# --no-net gives the container a private, empty network namespace. The only
# path out is the Unix socket bound at /run/llm, which bootstrap.py relays onto
# the container's own loopback so `baseURL: http://127.0.0.1:PORT/v1` still works.
NET_ARGS=()
if [ "$NO_NET" = 1 ]; then
    sockdir="${OPENCODE_LLM_SOCKET_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/opencode}"
    if [ ! -S "$sockdir/llm.sock" ]; then
        echo "Error: --no-net requires the relay socket at $sockdir/llm.sock" >&2
        echo "       Start the host relay first:  process-compose up -d" >&2
        echo "       (or: systemctl --user start opencode-llm-relay)" >&2
        exit 1
    fi
    NET_ARGS=(--net --network none --bind "$sockdir:/run/llm:ro")
    if [ -n "${OPENCODE_LLM_PORT:-}" ]; then
        EXTRA_ENV+=("OPENCODE_LLM_PORT=$OPENCODE_LLM_PORT")
    fi
fi

GPU_ARGS=()
if [ "$USE_GPU" = 1 ]; then
    GPU_ARGS=(--nv)
fi

# --- scratch dir backing /tmp and /var/tmp ----------------------------------
# Replaces docker's `--tmpfs /tmp:exec,size=512m`. Point TMPDIR at a size-capped
# tmpfs beforehand if you want a hard cap.
scratch="$(mktemp -d "${TMPDIR:-/tmp}/opencode-apptainer.XXXXXXXX")"
cleanup() { rm -rf "$scratch"; }
trap cleanup EXIT INT TERM

# --- environment ------------------------------------------------------------
# --containall implies --cleanenv, so everything the TUI needs is passed explicitly.
ENV_ARGS=(
    --env "TERM=${TERM:-xterm-256color}"
    --env "LANG=C.UTF-8"
)
if [ -n "${COLORTERM:-}" ]; then
    ENV_ARGS+=(--env "COLORTERM=$COLORTERM")
fi
for assignment in ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}; do
    ENV_ARGS+=(--env "$assignment")
done

# Not using host proxy settings (both cases; tools differ on which they read)

# Git settings (no git credentials in the container)h
#GIT_ARGS=(--env "GIT_CONFIG_GLOBAL=/opt/opencode-gitconfig"
#          --env "GIT_TERMINAL_PROMPT=0" 
#          --env "GIT_ASKPASS=/bin/true")

GIT_ARGS=(
    --env "GIT_CONFIG_GLOBAL=/opt/opencode-gitconfig"
    --env "GIT_TERMINAL_PROMPT=0"
    --env "GIT_ASKPASS=/bin/true"
    --env "GIT_AUTHOR_NAME=$(git config --get user.name || echo 'Unit_001')"
    --env "GIT_AUTHOR_EMAIL=$(git config --get user.email || echo 'unit_001@fnc.ai')"
    --env "GIT_COMMITTER_NAME=Unit_001"
    --env "GIT_COMMITTER_EMAIL=unit_001@fnc.ai"
)
# and add /opt/opencode-gitconfig to the image's %post.

# --- run --------------------------------------------------------------------
# Security posture, versus the docker/podman flags this replaces:
#   --read-only              -> inherent: the SIF is an immutable squashfs
#   --cap-drop=ALL           -> inherent: unprivileged user namespace, no capabilities
#   --security-opt=no-new-privileges -> inherent: NO_NEW_PRIVS + nosuid mounts
#   USER 1000 / --userns=keep-id     -> inherent: runs as the invoking user
#   --containall             -> isolates env, IPC, PID, /tmp, /dev and home
# 
set +e
"$APPTAINER_BIN" run \
    --containall \
    --home "$state_dir:/app" \
    --workdir "$scratch" \
    --pwd /workspace \
    --bind "$WORKSPACE:/workspace:rw" \
    --bind "$state_dir/config:/app/.config/opencode:rw" \
    --bind "$state_dir/secrets:/run/secrets:ro" \
    ${NET_ARGS[@]+"${NET_ARGS[@]}"} \
    ${GPU_ARGS[@]+"${GPU_ARGS[@]}"} \
    ${GIT_ARGS[@]+"${GIT_ARGS[@]}"} \
    ${ENV_ARGS[@]+"${ENV_ARGS[@]}"} \
    "$SIF" "$@"
status=$?
set -e

exit "$status"
