#!/usr/bin/env bash
#
# OpenCode Docker wrapper script
# Add this directory to your PATH to run the Docker isolated OpenCode from anywhere
#
# Options:
#   -b, --brainstorm    Enable brainstorming server (exposes port for real-time collaboration)
#   -w, --websearch     Enable web search (sets OPENCODE_ENABLE_EXA=1)
#   -e, --experimental  Enable experimental features (sets OPENCODE_EXPERIMENTAL=1 and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

bootstrap() {
    local ocd_dir="$HOME/.opencode-docker"
    local repo_dir="${OPENCODE_DOCKER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

    mkdir -p "$ocd_dir"
    chmod 700 "$ocd_dir"

    mkdir -p "$ocd_dir/config"
    mkdir -p "$ocd_dir/secrets"
    chmod 700 "$ocd_dir/config"
    chmod 700 "$ocd_dir/secrets"

    if [ -d "$repo_dir/config" ]; then
        shopt -s dotglob nullglob
        for source_path in "$repo_dir/config"/*; do
            target_path="$ocd_dir/config/$(basename "$source_path")"
            if [ ! -e "$target_path" ]; then
                cp -a "$source_path" "$target_path"
            fi
        done
        shopt -u dotglob nullglob
    fi
}

bootstrap

# Default workspace to current directory if not specified
WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"

if [ ! -d "$WORKSPACE" ]; then
    echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2
    exit 1
fi

BRAINSTORM_PORT=""
BRAINSTORM_HOST=""
PORT_MAPPING=""
EXTRA_ENV=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--brainstorm)
            BRAINSTORM_PORT=$((49152 + RANDOM % 16383))
            BRAINSTORM_HOST="0.0.0.0"
            PORT_MAPPING="-p ${BRAINSTORM_PORT}:${BRAINSTORM_PORT}"
            shift
            ;;
        -w|--websearch)
            EXTRA_ENV+=("-e OPENCODE_ENABLE_EXA=1")
            shift
            ;;
        -e|--experimental)
            EXTRA_ENV+=("-e OPENCODE_EXPERIMENTAL=1")
            EXTRA_ENV+=("-e OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1")
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ -t 0 ]; then
    DOCKER_FLAGS="-it"
else
    DOCKER_FLAGS="-i"
fi

GITCONFIG_MOUNT=()
if [ -f "$HOME/.gitconfig" ]; then
    GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:/app/.gitconfig:ro")
fi

docker run --rm $DOCKER_FLAGS \
    --read-only \
    --tmpfs /tmp:exec,size=512m \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory=2g \
    --cpus=2 \
    ${PORT_MAPPING} \
    ${BRAINSTORM_PORT:+-e BRAINSTORM_PORT="${BRAINSTORM_PORT}"} \
    ${BRAINSTORM_HOST:+-e BRAINSTORM_HOST="${BRAINSTORM_HOST}"} \
    "${EXTRA_ENV[@]}" \
    -v "$HOME/.opencode-docker:/app:rw" \
    "${GITCONFIG_MOUNT[@]}" \
    -v "$HOME/.opencode-docker/config:/app/.config/opencode:rw" \
    -v "$HOME/.opencode-docker/secrets:/run/secrets:ro" \
    -v "$WORKSPACE:/workspace:rw" \
    opencode-docker:latest /workspace "$@"
