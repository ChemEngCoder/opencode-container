#!/usr/bin/env bash
#
# OpenCode Docker wrapper script
# Add this directory to your PATH to run the Docker isolated OpenCode from anywhere
#
# Options:
#   -w, --websearch     Enable web search (sets OPENCODE_ENABLE_EXA=1)
#   -e, --experimental  Enable experimental features (sets OPENCODE_EXPERIMENTAL=1 and OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1)
#   -u, --update-config Overwrite ~/.opencode-docker/config/ files with repo versions
#   -m, --memory        Set memory limit (default: 4g, e.g., -m 8g)
#   -c, --cpus          Set CPU count (default: 4, e.g., -c 8)

set -e

UPDATE_CONFIG=0
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ocd_dir="$HOME/.opencode-docker"
repo_dir="${OPENCODE_DOCKER_REPO:-$(cd "$SCRIPT_DIR/.." && pwd)}"

mkdir -p "$ocd_dir/config" "$ocd_dir/secrets"
chmod 700 "$ocd_dir" "$ocd_dir/config" "$ocd_dir/secrets"

# Build env-file from secrets directory (each file name = env var name, content = value)
env_file="$ocd_dir/.env"
: > "$env_file"
chmod 600 "$env_file"
for f in "$ocd_dir/secrets"/*; do
  [ -f "$f" ] && printf '%s=%s\n' "$(basename "$f")" "$(cat "$f")" >> "$env_file"
done

if [ -d "$repo_dir/config" ]; then
  if [ "$UPDATE_CONFIG" = 1 ]; then
    cp -a "$repo_dir/config/." "$ocd_dir/config/"
  else
    cp -a --update=none "$repo_dir/config/." "$ocd_dir/config/"
  fi
fi

# Default workspace to current directory if not specified
WORKSPACE="${OPENCODE_WORKSPACE:-$(pwd)}"

if [ ! -d "$WORKSPACE" ]; then
    echo "Error: workspace path is not an existing directory: $WORKSPACE" >&2
    exit 1
fi

EXTRA_ENV=()
MEMORY_LIMIT="${MEMORY_LIMIT:-4g}"
CPU_LIMIT="${CPU_LIMIT:-4}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -u|--update-config)
            UPDATE_CONFIG=1
            shift
            ;;
        -w|--websearch)
            EXTRA_ENV+=("-e OPENCODE_ENABLE_EXA=1")
            shift
            ;;
        -e|--experimental)
            EXTRA_ENV+=("-e OPENCODE_EXPERIMENTAL=1")
            EXTRA_ENV+=("-e OPENCODE_ENABLE_EXPERIMENTAL_MODELS=1")
            shift
            ;;
        -m|--memory)
            MEMORY_LIMIT="$2"
            shift 2
            ;;
        -c|--cpus)
            CPU_LIMIT="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [ -t 0 ]; then
    DOCKER_FLAGS="-it"
else
    DOCKER_FLAGS="-i"
fi

GITCONFIG_MOUNT=()
if [ -f "$HOME/.gitconfig" ]; then
    GITCONFIG_MOUNT=(-v "$HOME/.gitconfig:/app/.gitconfig:ro")
fi

docker run --rm $DOCKER_FLAGS \
    --read-only \
    --tmpfs /tmp:exec,size=512m \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory="${MEMORY_LIMIT}" \
    --cpus="${CPU_LIMIT}" \
    --env-file "$env_file" \
    "${EXTRA_ENV[@]}" \
    -v "$HOME/.opencode-docker:/app:rw" \
    "${GITCONFIG_MOUNT[@]}" \
    -v "$HOME/.opencode-docker/config:/app/.config/opencode:rw" \
    -v "$HOME/.opencode-docker/secrets:/run/secrets:ro" \
    -v "$WORKSPACE:/workspace:rw" \
    opencode-docker:latest /workspace "$@"
