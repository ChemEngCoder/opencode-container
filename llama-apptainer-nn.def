# =============================================================================
#  llama.cpp — CUDA build for NVIDIA Hopper (H100, sm_90)
#  Apptainer / SingularityCE definition file
#
#  Build:
#     apptainer build --fakeroot llama-cpp-cuda.sif apptainer.def
#     # or, on a cluster without fakeroot:
#     apptainer build --remote llama-cpp-cuda.sif apptainer.def
#
#  Run (the --nv flag is what makes it GPU-aware):
#     apptainer run --nv --bind /scratch/models:/models llama-cpp-cuda.sif \
#         -m /models/model.gguf --n-gpu-layers 999 --host 0.0.0.0 --port 8080
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — compile
# -----------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.2-devel-ubuntu24.04
Stage: build

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # --- knobs -------------------------------------------------------------
    # Pin to a tag (e.g. b7412) or a commit SHA for reproducible images.
    LLAMA_REF="master"

    # H100 is compute capability 9.0. "90-real" emits SASS for sm_90 only and
    # skips the PTX blob. Use "80-real;90-real" for a mixed A100/H100 cluster,
    # or append ";90-virtual" if you want JIT forward-compat onto Blackwell.
    CUDA_ARCH="90-real"

    # Single directory for executables AND backend modules. This is the whole
    # point of rev 2 — do not split these apart again.
    PREFIX="/opt/llama.cpp"

    NPROC="$(nproc)"
    # -----------------------------------------------------------------------

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        ccache \
        cmake \
        git \
        socat \
        libcurl4-openssl-dev \
        libgomp1 \
        ninja-build \
        pkg-config \
        python3
    rm -rf /var/lib/apt/lists/*

    mkdir -p /src
    cd /src
    # Shallow-clone when LLAMA_REF is a branch or tag; fall back to a full
    # clone so a raw commit SHA also works.
    git clone --depth 1 --branch "${LLAMA_REF}" \
        https://github.com/ggml-org/llama.cpp.git llama.cpp \
      || { git clone https://github.com/ggml-org/llama.cpp.git llama.cpp \
           && git -C llama.cpp checkout "${LLAMA_REF}"; }
    cd /src/llama.cpp

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
        -DGGML_CUDA=ON \
        -DGGML_NATIVE=OFF \
        -DGGML_BACKEND_DL=ON \
        -DGGML_CPU_ALL_VARIANTS=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DLLAMA_CURL=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        -DLLAMA_BUILD_EXAMPLES=OFF \
        -DLLAMA_BUILD_SERVER=ON
    #
    #  GGML_NATIVE=OFF          the build host is not the compute host. Without
    #                           this, -march=native bakes in the builder's ISA
    #                           and the SIF SIGILLs on an older node.
    #  GGML_BACKEND_DL=ON  +    backends become dlopen'd .so files and the CPU
    #  GGML_CPU_ALL_VARIANTS    backend ships one variant per ISA level, chosen
    #                           at runtime. Together these make one SIF safe on
    #                           a heterogeneous cluster. If your nodes are
    #                           uniform and you would rather not think about
    #                           the dlopen search path at all, set
    #                           -DGGML_BACKEND_DL=OFF -DGGML_CPU_ALL_VARIANTS=OFF
    #                           and the backends are linked straight in.
    #  LLAMA_CURL=ON            enables `-hf user/repo` pulls; drop it (and
    #                           libcurl) for an air-gapped image.
    #
    #  Optional, deliberately off:
    #  -DGGML_CUDA_FA_ALL_QUANTS=ON   all KV-cache quant combos for flash
    #                                 attention; large compile-time cost.
    #  -DGGML_CUDA_FORCE_MMQ=ON       force custom quantised matmul kernels.

    cmake --build build --config Release -j "${NPROC}"

    # ---- flat layout: executables and every .so in the SAME directory ------
    mkdir -p "${PREFIX}/bin"
    find build/bin -maxdepth 1 -type f -executable ! -name '*.so*' \
        -exec cp {} "${PREFIX}/bin/" \;
    find build -name '*.so*' -exec cp -P {} "${PREFIX}/bin/" \;
    cp LICENSE "${PREFIX}/" || true

    # Fail the build here rather than at 3am on a compute node.
    test -f "${PREFIX}/bin/llama-server"
    test -f "${PREFIX}/bin/libggml-cuda.so"
    ls "${PREFIX}/bin"/libggml-cpu*.so >/dev/null

    {
        echo "llama.cpp ref:     ${LLAMA_REF}"
        echo "llama.cpp commit:  $(git rev-parse HEAD)"
        echo "cuda arch:         ${CUDA_ARCH}"
        echo "nvcc:              $(nvcc --version | tail -n2 | head -n1)"
        echo "built:             $(date -u +%Y-%m-%dT%H:%M:%SZ)"
        echo "backend modules:   $(cd "${PREFIX}/bin" && ls libggml-*.so | tr '\n' ' ')"
    } > "${PREFIX}/BUILD_INFO"

# -----------------------------------------------------------------------------
# Stage 2 — runtime
# -----------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.2-runtime-ubuntu24.04
Stage: final

%files from build
    /opt/llama.cpp /opt/llama.cpp

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # libcurl4t64 is the Ubuntu 24.04 name; the fallback keeps this def usable
    # if you retarget the base image at 22.04.
    apt-get install -y --no-install-recommends ca-certificates libgomp1 \
        && { apt-get install -y --no-install-recommends libcurl4t64 \
             || apt-get install -y --no-install-recommends libcurl4; }
    rm -rf /var/lib/apt/lists/*

    mkdir -p /models /workspace
    chmod 1777 /workspace

%environment
    export LLAMA_HOME=/opt/llama.cpp
    export PATH="${LLAMA_HOME}/bin:${PATH}"
    # Backend discovery. ggml does NOT read LD_LIBRARY_PATH for this — the
    # executable-directory search is what actually finds the modules, and this
    # variable is the explicit second route.
    export GGML_BACKEND_PATH="${LLAMA_HOME}/bin"
    # Link-time resolution of libggml-base.so etc. Appended, never overwritten:
    # Apptainer puts the host driver libraries injected by --nv on
    # LD_LIBRARY_PATH (/.singularity.d/libs), and clobbering that is the
    # classic "cannot find libcuda.so.1" failure. Note that Apptainer may
    # replace this with the host's value if the host has LD_LIBRARY_PATH set
    # (module systems do) — which is exactly why backend discovery must not
    # depend on it.
    export LD_LIBRARY_PATH="${LLAMA_HOME}/bin:${LD_LIBRARY_PATH:-}"
    # Models downloaded with -hf land here; bind it, or the container writes to
    # $HOME, which on most clusters is quota'd and slow.
    export LLAMA_CACHE="${LLAMA_CACHE:-/workspace/.cache/llama.cpp}"
    # Uncomment to let the CUDA allocator spill into host memory (useful for
    # oversized KV caches; costs PCIe bandwidth whenever it triggers).
    # export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

%runscript
    # `apptainer run <sif> <tool> [args]` dispatches to any llama-* binary;
    # anything else is treated as arguments to llama-server.
    if [ "$#" -gt 0 ] && [ -x "/opt/llama.cpp/bin/$1" ]; then
        _exe="$1"; shift
        exec "/opt/llama.cpp/bin/${_exe}" "$@"
    fi
    exec /opt/llama.cpp/bin/llama-server "$@"

%apprun server
    exec /opt/llama.cpp/bin/llama-server "$@"

%apprun cli
    exec /opt/llama.cpp/bin/llama-cli "$@"

%apprun bench
    exec /opt/llama.cpp/bin/llama-bench "$@"

%apprun quantize
    exec /opt/llama.cpp/bin/llama-quantize "$@"

%apprun perplexity
    exec /opt/llama.cpp/bin/llama-perplexity "$@"

%test
    # Runs at build time, usually without a GPU. It cannot prove a device is
    # visible, but it CAN prove the backends load — which is the failure rev 1
    # shipped. Device visibility is checked separately at runtime with:
    #   apptainer exec --nv llama-cpp-cuda.sif llama-cli --list-devices
    set -e
    test -f /opt/llama.cpp/bin/libggml-cuda.so
    ldd /opt/llama.cpp/bin/libggml-cuda.so | grep -v libcuda.so.1 \
        | grep 'not found' && { echo "FAIL: unresolved deps"; exit 1; } || true
    out="$(/opt/llama.cpp/bin/llama-cli --list-devices 2>&1)"
    echo "$out"
    echo "$out" | grep -q 'load_backend' \
        || { echo "FAIL: no backend was dlopen'd"; exit 1; }
    echo "OK: backends load"
    cat /opt/llama.cpp/BUILD_INFO

%labels
    Author        Mark
    Application   llama.cpp
    Backend       CUDA (Hopper / sm_90)
    Base          nvidia/cuda:13.0.2-runtime-ubuntu24.04

%help
    llama.cpp compiled for NVIDIA H100 (compute capability 9.0).

    GPU access requires --nv, which binds the host NVIDIA driver into the
    container. No driver is installed in the image by design.

      # serve a model over HTTP
      apptainer run --nv --bind /scratch/models:/models \
          llama-cpp-cuda.sif -m /models/llama-3.1-70b-q4_k_m.gguf \
          --n-gpu-layers 999 --ctx-size 8192 --host 0.0.0.0 --port 8080

      # one-shot generation
      apptainer run --nv llama-cpp-cuda.sif cli \
          -m /models/model.gguf -p "Explain MIG partitioning." -ngl 999

      # throughput sweep
      apptainer run --nv llama-cpp-cuda.sif bench -m /models/model.gguf

      # confirm the GPU is visible
      apptainer exec --nv llama-cpp-cuda.sif llama-cli --list-devices

    Multi-GPU on an 8x H100 node: --tensor-split and --split-mode are handled
    by llama.cpp itself; restrict visible devices with
    --env CUDA_VISIBLE_DEVICES=0,1 or let Slurm's --gpus binding do it.

    Build provenance (upstream ref, commit, nvcc version) is recorded in
    /opt/llama.cpp/BUILD_INFO.
