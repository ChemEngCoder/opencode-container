# =============================================================================
#  llama.cpp (VeroFess Qwen3.8 fork) — CUDA build for NVIDIA Ampere
#  2x RTX 3090 (GA102, sm_86), Unix-socket bridge edition
#  Apptainer / SingularityCE definition file
#
#  Build from the directory that holds llama-serve.sh: %files resolves that
#  path relative to where you run `apptainer build`.
#     apptainer build --fakeroot llama-nn.sif apptainer-llama-nn.def
#     # pin a different fork commit, or build more jobs in parallel:
#     apptainer build --fakeroot --build-arg JOBS=8 llama-nn.sif apptainer-llama-nn.def
#
#  Run (socket bridge; the container has no network, only the socket):
#     mkdir -p -m 700 "$XDG_RUNTIME_DIR/llm"
#     apptainer run --app bridge --nv --pid --net --network none \
#         --bind /models:/models:ro \
#         --bind "$XDG_RUNTIME_DIR/llm":/run/llm:rw \
#         --env CUDA_VISIBLE_DEVICES=0,1 \
#         --env LLAMA_MODEL=/models/Qwen3.8-27B-Q8_0.gguf \
#         llama-nn.sif
#
#     curl --unix-socket "$XDG_RUNTIME_DIR/llm/llm.sock" http://localhost/health
#
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — compile
# -----------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.2-devel-ubuntu24.04
Stage: build

%arguments
    # Pin to a commit SHA for reproducible images. This is the commit the
    # Qwen3.8 profile was last checked against.
    LLAMA_REPO=https://github.com/VeroFess/llama.cpp_3090x2_qwen3.8_q8_opt.git
    LLAMA_REF=3ba533a54aacf9091f669f8a16cdaf88c8e8e60d
    # The FlashAttention kernels (GGML_CUDA_FA_ALL_QUANTS=ON in the fork's
    # preset) need roughly 4-6 GB of RAM per compile job. Raise with care.
    JOBS=4

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive

    # --- knobs -------------------------------------------------------------
    # RTX 3090 is compute capability 8.6. "86-real" emits SASS for sm_86 only
    # and skips the PTX blob. The fork's Qwen3.8 profile refuses any device
    # that is not SM86, so there is nothing to gain from more architectures.
    CUDA_ARCH="86-real"

    # Single directory for executables, the bridge script and the one shared
    # library we ship (NCCL). Do not split these apart.
    PREFIX="/opt/llama.cpp"
    # -----------------------------------------------------------------------

    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libnccl-dev \
        libnccl2 \
        libssl-dev \
        ninja-build \
        pkg-config \
        python3
    rm -rf /var/lib/apt/lists/*

    # The base image's apt sources include NVIDIA's CUDA repository, so these
    # resolve to NVIDIA's +cuda13.x builds. Ubuntu's own archive carries an
    # older, generic NCCL (e.g. 2.18.5-1-2); refuse to build against it.
    dpkg-query -W -f='${Version}\n' libnccl-dev | tee /dev/stderr | grep -q '+cuda13' \
        || { echo "FAIL: libnccl-dev is not NVIDIA's CUDA 13 build" >&2; exit 1; }

    mkdir -p /src
    cd /src
    git clone --depth 1 --branch "{{ LLAMA_REF }}" "{{ LLAMA_REPO }}" llama.cpp \
      || { git clone "{{ LLAMA_REPO }}" llama.cpp \
           && git -C llama.cpp checkout "{{ LLAMA_REF }}"; }
    cd /src/llama.cpp

    cmake --preset qwen38-3090-release \
        -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCH}" \
        -DGGML_NATIVE=OFF \
        -DLLAMA_BUILD_TESTS=OFF \
        2>&1 | tee /src/configure.log
    #
    #  --preset qwen38-3090-release   the fork's tested configuration: static
    #                           link (BUILD_SHARED_LIBS=OFF), FlashAttention
    #                           with all KV quant combos, CUDA graphs, NCCL,
    #                           and the GGML_QWEN38_2X3090 profile. Without
    #                           that last one, --profile is rejected at start.
    #  GGML_NATIVE=OFF          the build host is not necessarily the compute
    #                           host. Without this, -march=native bakes in the
    #                           builder's ISA and the SIF SIGILLs elsewhere.
    #  Static, not GGML_BACKEND_DL: the profile is only tested linked straight
    #                           in, and a single-box deployment has no
    #                           heterogeneous CPUs to dispatch across. As a
    #                           side effect there is no dlopen search path to
    #                           get wrong (GGML_BACKEND_PATH is not needed).
    #  LLAMA_CURL is deprecated in this tree; -hf pulls use OpenSSL, which
    #                           the profile also needs for model hashing.

    # NCCL missing is only a WARNING in the fork's CMake, and the result is a
    # silently slower all-reduce. Make it fatal.
    if grep -qi 'NCCL not found' /src/configure.log; then
        echo "FAIL: NCCL not found at configure time" >&2
        exit 1
    fi

    cmake --build --preset qwen38-3090-release -j "{{ JOBS }}" \
        --target llama-server llama-cli llama-bench llama-quantize \
                 llama-perplexity llama-gguf

    # ---- flat layout --------------------------------------------------------
    mkdir -p "${PREFIX}/bin"
    for exe in llama-server llama-cli llama-bench llama-quantize \
               llama-perplexity llama-gguf; do
        cp "build-qwen38-3090/bin/${exe}" "${PREFIX}/bin/"
    done
    cp tools/llama-qwen38-tune "${PREFIX}/bin/"
    # Ship the exact NCCL the binary was linked against, next to it.
    nccl_so="$(ldconfig -p | awk '/libnccl\.so\.2 /{print $NF; exit}')"
    cp -L "${nccl_so}" "${PREFIX}/bin/libnccl.so.2"
    cp LICENSE "${PREFIX}/" || true

    # Fail the build here rather than at 3am.
    test -f "${PREFIX}/bin/llama-server"
    ldd "${PREFIX}/bin/llama-server" | grep -q libnccl \
        || { echo "FAIL: llama-server is not linked against NCCL" >&2; exit 1; }

    {
        echo "llama.cpp repo:    {{ LLAMA_REPO }}"
        echo "llama.cpp ref:     {{ LLAMA_REF }}"
        echo "llama.cpp commit:  $(git rev-parse HEAD)"
        echo "cuda arch:         ${CUDA_ARCH}"
        echo "nvcc:              $(nvcc --version | tail -n2 | head -n1)"
        echo "nccl:              $(dpkg-query -W -f='${Version}' libnccl2)"
        echo "built:             $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "${PREFIX}/BUILD_INFO"

# -----------------------------------------------------------------------------
# Stage 2 — runtime
# -----------------------------------------------------------------------------
Bootstrap: docker
From: nvidia/cuda:13.0.2-runtime-ubuntu24.04
Stage: final

%files from build
    /opt/llama.cpp /opt/llama.cpp

%files
    llama-serve.sh /opt/llama.cpp/bin/llama-serve.sh

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    # socat:   the Unix-socket bridge in llama-serve.sh
    # libssl3t64: OpenSSL for the profile's model hashing and -hf pulls
    #          (Ubuntu 24.04 name; libssl3 on 22.04)
    # python3: llama-qwen38-tune
    # curl:    health checks from inside the container (`apptainer exec`)
    apt-get install -y --no-install-recommends \
        ca-certificates curl libgomp1 python3 socat \
        && { apt-get install -y --no-install-recommends libssl3t64 \
             || apt-get install -y --no-install-recommends libssl3; }
    rm -rf /var/lib/apt/lists/*

    chmod 0755 /opt/llama.cpp/bin/llama-serve.sh /opt/llama.cpp/bin/llama-qwen38-tune

    # Bind targets. /run/llm is where the host's socket directory lands; it
    # must exist in the image because --net --network none runs are usually
    # unprivileged, and an unprivileged bind needs a pre-made mount point
    # (or an underlay) to land on.
    mkdir -p /models /workspace /run/llm
    chmod 1777 /workspace

%environment
    export LLAMA_HOME=/opt/llama.cpp
    export PATH="${LLAMA_HOME}/bin:${PATH}"
    # Appended, never overwritten: --nv puts the host driver libraries on
    # LD_LIBRARY_PATH (/.singularity.d/libs), and clobbering that is the
    # classic "cannot find libcuda.so.1" failure. Our own entry is only for
    # libnccl.so.2; everything else in the binary is linked statically.
    export LD_LIBRARY_PATH="${LLAMA_HOME}/bin:${LD_LIBRARY_PATH:-}"
    # Models downloaded with -hf land here; bind it, or the container writes
    # to $HOME.
    export LLAMA_CACHE="${LLAMA_CACHE:-/workspace/.cache/llama.cpp}"
    # The fork's fast path: P2P between the two cards, NCCL all-reduce.
    export GGML_CUDA_P2P="${GGML_CUDA_P2P:-1}"
    export GGML_CUDA_ALLREDUCE="${GGML_CUDA_ALLREDUCE:-nccl}"
    export NCCL_DEBUG="${NCCL_DEBUG:-WARN}"
    # Watchdog for one decode/sync call. 120 s is the fork's default; very
    # long prompts on warm cards can need more. Minimum accepted is 30000.
    export LLAMA_CUDA_WATCHDOG_MS="${LLAMA_CUDA_WATCHDOG_MS:-300000}"

%runscript
    # `apptainer run <sif> <tool> [args]` dispatches to anything in
    # /opt/llama.cpp/bin (llama-* binaries, llama-serve.sh, llama-qwen38-tune);
    # anything else is treated as arguments to llama-server.
    if [ "$#" -gt 0 ] && [ -x "/opt/llama.cpp/bin/$1" ]; then
        _exe="$1"; shift
        exec "/opt/llama.cpp/bin/${_exe}" "$@"
    fi
    exec /opt/llama.cpp/bin/llama-server "$@"

%startscript
    # `apptainer instance start ... llama-nn.sif <name>` runs the bridge.
    exec /opt/llama.cpp/bin/llama-serve.sh

%apprun bridge
    exec /opt/llama.cpp/bin/llama-serve.sh "$@"

%apprun server
    exec /opt/llama.cpp/bin/llama-server "$@"

%apprun cli
    exec /opt/llama.cpp/bin/llama-cli "$@"

%apprun bench
    exec /opt/llama.cpp/bin/llama-bench "$@"

%apprun quantize
    exec /opt/llama.cpp/bin/llama-quantize "$@"

%apprun perplexity
    exec /opt/llama.cpp/bin/llama-perplexity "$@"

%apprun tune
    exec python3 -B /opt/llama.cpp/bin/llama-qwen38-tune "$@"

%test
    # Runs at build time, without a GPU and without --nv, so no binary that
    # links libcuda.so.1 can be executed here. What CAN be proven: every
    # library except the driver resolves, and the bridge has what it needs.
    # Device visibility is checked at runtime with:
    #   apptainer exec --nv llama-nn.sif nvidia-smi topo -p2p r
    set -e
    for exe in llama-server llama-cli llama-bench; do
        if ldd "/opt/llama.cpp/bin/${exe}" | grep -v 'libcuda.so.1' | grep -q 'not found'; then
            echo "FAIL: unresolved deps in ${exe}"
            ldd "/opt/llama.cpp/bin/${exe}" | grep 'not found'
            exit 1
        fi
    done
    command -v socat >/dev/null || { echo "FAIL: socat missing"; exit 1; }
    sh -n /opt/llama.cpp/bin/llama-serve.sh || { echo "FAIL: llama-serve.sh syntax"; exit 1; }
    test -d /run/llm || { echo "FAIL: /run/llm bind target missing"; exit 1; }
    echo "OK: libraries resolve, bridge is present"
    cat /opt/llama.cpp/BUILD_INFO

%labels
    Author        Mark
    Application   llama.cpp (VeroFess Qwen3.8 2x3090 fork)
    Backend       CUDA (Ampere / sm_86)
    Base          nvidia/cuda:13.0.2-runtime-ubuntu24.04

%help
    llama.cpp, VeroFess Qwen3.8 fork, compiled for 2x RTX 3090
    (compute capability 8.6), with a Unix-socket bridge.

    GPU access requires --nv, which binds the host NVIDIA driver into the
    container. No driver is installed in the image by design. The host
    driver must support CUDA 13.0.

      # serve over a Unix socket; the container itself has no network
      mkdir -p -m 700 "$XDG_RUNTIME_DIR/llm"
      apptainer run --app bridge --nv --pid --net --network none \
          --bind /models:/models:ro \
          --bind "$XDG_RUNTIME_DIR/llm":/run/llm:rw \
          --env CUDA_VISIBLE_DEVICES=0,1 \
          --env LLAMA_MODEL=/models/Qwen3.8-27B-Q8_0.gguf \
          llama-nn.sif

      # talk to it from the host
      curl --unix-socket "$XDG_RUNTIME_DIR/llm/llm.sock" http://localhost/v1/models

      # any other model: turn the Qwen3.8 profile off (generic mode)
      ... --env LLAMA_PROFILE= --env LLAMA_MODEL=/models/other.gguf \
          --env LLAMA_CTX=32768 ...

      # plain HTTP instead of the bridge (host network)
      apptainer run --nv --bind /models:/models:ro llama-nn.sif \
          --model /models/Qwen3.8-27B-Q8_0.gguf \
          --profile qwen38-27b-q8-2x3090 --split-mode tensor --port 8080

      # confirm both GPUs and the P2P path are visible
      apptainer exec --nv llama-nn.sif nvidia-smi topo -p2p r

    llama-serve.sh documents every environment variable it reads:
      apptainer exec llama-nn.sif sed -n '1,60p' /opt/llama.cpp/bin/llama-serve.sh

    Build provenance (repo, commit, nvcc, NCCL version) is recorded in
    /opt/llama.cpp/BUILD_INFO.
